APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Token quota per user. Set AI_USAGE_PHASE=training to switch to the training allowance.
AI_USAGE_PHASE=testing
# Set when switching phase so users start with a fresh quota, e.g. 2026-10-01 00:00:00
AI_USAGE_PHASE_STARTED_AT=
AI_TESTING_TOKEN_LIMIT=20000000
AI_TRAINING_TOKEN_LIMIT=10000000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recipient for internal notifications when users submit AI+ support tickets.
AI_PLUS_SUPPORT_RECIPIENT=ciec.coordinator.04@lsts.edu.vn

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI API (AI+ Agent Workspace)
# Lấy key tại https://platform.openai.com/api-keys
# Lưu ý: đừng commit .env thật. Chỉ commit .env.example (không có giá trị thật).
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_TOKENS=8192
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=120
OPENAI_RETRY_TIMES=2
OPENAI_RETRY_DELAY_MS=300
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RAG_EMBEDDINGS_ENABLED=true

# Read public web pages explicitly linked in an AI+ chat message. Private/IP
# address targets are always blocked by the application.
AI_PLUS_WEB_READING_ENABLED=true
AI_PLUS_WEB_BROWSER_RENDERING_ENABLED=true

# Required only to read scanned/image-only PDFs in chat. Install Poppler, then
# set the absolute pdftoppm path (Linux commonly /usr/bin/pdftoppm).
PDFTOPPM_BINARY=
PDF_SCAN_MAX_PAGES=3
PDF_SCAN_MAX_WIDTH=1280
